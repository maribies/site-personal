{
  "name": "site-personal",
  "version": "1.0.0",
  "description": "Personal website.",
  "main": "index.js",
  "repository": "https://github.com/maribies/site-personal.git",
  "author": "<Marissa> <<marissa.biesecker@gmail.com>>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run prerender",
    "fix-css": "stylelint '**/*.css' --fix",
    "fix-lint": "eslint --fix",
    "format": "prettier --write .",
    "hooks": "git config core.hooksPath .githooks",
    "lint": "eslint . && stylelint \"**/*.css\"",
    "prerender": "node scripts/prerender.ts",
    "preview": "vite preview",
    "test": "vitest run --exclude tests/build.test.ts",
    "test:build": "vitest run tests/build.test.ts",
    "test:watch": "vitest --exclude tests/build.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/dela-gothic-one": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@react-spring/web": "10.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "engines": {
    "node": "24.x"
  }
}
